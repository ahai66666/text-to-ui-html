    "preview": "node scripts/preview-page.mjs",
    "components:index:build": "node scripts/build-component-route-index.mjs",
    "components:index:check": "node scripts/build-component-route-index.mjs --check",
    "components:registry:build": "node scripts/build-component-contract-registry.mjs",
