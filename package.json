{
  "name": "text-to-ui-html",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "description": "text-to-ui-html independent skill",
  "license": "MIT",
  "scripts": {
    "resources:build": "node scripts/build-resource-index.mjs --repo .",
    "resources:check": "node scripts/build-resource-index.mjs --repo . --check",
    "resources:query": "node scripts/query-resources.mjs",
    "catalog:build": "node scripts/build-skill-catalog-index.mjs",
    "catalog:check": "node scripts/build-skill-catalog-index.mjs --check",
    "index:build": "node scripts/build-navigation-index.mjs --repo . --skill-root .",
    "index:check": "node scripts/build-navigation-index.mjs --repo . --skill-root . --check",
    "workflow:route": "node scripts/resolve-workflow-route.mjs",
    "skill:manifest": "node scripts/skill-distribution.mjs manifest",
    "skill:check": "node scripts/skill-distribution.mjs check",
    "skill:pack": "node scripts/skill-distribution.mjs pack",
